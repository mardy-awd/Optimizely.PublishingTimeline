<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>Mardy.Optimizely.PublishingTimeline</PackageId>
    <Version>1.0.0</Version>
    <Authors>mardy-awd</Authors>
    <Copyright>Copyright (c) 2026 mardy-awd</Copyright>
    <Description>Publishing Timeline for Optimizely CMS 13: shows scheduled publications in a table and monthly calendar below the CMS Dashboard, with language, date and timezone filters.</Description>
    <PackageTags>optimizely;episerver;cms;cms13;dashboard;scheduled-publishing;calendar;addon</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/mardy-awd/Optimizely.PublishingTimeline</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mardy-awd/Optimizely.PublishingTimeline.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mardy.Optimizely.PublishingTimeline.Tests" />
  </ItemGroup>

  <!-- Minimum supported CMS is 13.4.0; restore resolves the lowest version in the range,
       so the build compiles against 13.4.0. Upper bound excludes the next major.
       13.4.0 is the first CMS 13 release whose dependencies restored without NuGet audit
       warnings (October 2026); earlier 13.x pulls in SixLabors.ImageSharp 3.1.12. -->
  <ItemGroup>
    <!-- Content, versions, language branches, access checks, initialization module
         (EPiServer.Web.InitializationModule) and the episerver:cmsedit policy. -->
    <PackageReference Include="EPiServer.Cms.AspNetCore" Version="[13.4.0, 14.0.0)" />
    <!-- CMS UI: the Dashboard the panel is injected into. -->
    <PackageReference Include="EPiServer.CMS.UI.Core" Version="[13.4.0, 14.0.0)" />
  </ItemGroup>

</Project>
